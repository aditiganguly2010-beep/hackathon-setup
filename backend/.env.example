# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/legacy_health_monitor
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# LLM Configuration
GOOGLE_ADK_API_KEY=your_google_adk_api_key
GOOGLE_ADK_PROJECT_ID=your_project_id
LLM_MODEL=gemini-pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# LangTrace Configuration
LANGTRACE_API_KEY=your_langtrace_api_key
LANGTRACE_HOST=https://api.langtrace.ai

# Langfuse Configuration
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
RATE_LIMIT_PER_MINUTE=60

# Cache Configuration
CACHE_TTL_SECONDS=300

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
