# Database
DATABASE_URL=sqlite:///./test.db

# LLM Configuration
GOOGLE_ADK_API_KEY=test_key
GOOGLE_ADK_PROJECT_ID=test_project

# Observability
LANGTRACE_API_KEY=test_key
LANGTRACE_HOST=https://api.langtrace.ai
LANGFUSE_PUBLIC_KEY=test_key
LANGFUSE_SECRET_KEY=test_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_PER_MINUTE=60

# Cache
CACHE_TTL_SECONDS=300

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# Security
SECRET_KEY=test_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
